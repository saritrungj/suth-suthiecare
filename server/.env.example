# Copy to .env.local for local development.
# On the production server, copy to .env.production instead.

# Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Comma-separated exact hosts or wildcard subdomains. Untrusted banner/HTML links are removed.
TRUSTED_EXTERNAL_HOSTS=suth.go.th,*.suth.go.th

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_NAME=suthiecare_db
DB_CONNECTION_LIMIT=50
DB_QUEUE_LIMIT=0
DB_MAX_IDLE=20
DB_IDLE_TIMEOUT=60000

# Authentication and encryption
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES=8h
# Optional separate patient signing key. Falls back to JWT_SECRET when omitted.
PATIENT_JWT_SECRET=
PATIENT_JWT_EXPIRES=2h
AES_KEY=replace_with_64_hex_characters
AES_SEARCH_KEY=replace_with_at_least_32_characters

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=replace_me
# Use only on a developer machine, never in production.
DISABLE_TURNSTILE=false

# Resend email OTP (keep secrets only in the server environment)
RESEND_API_KEY=replace_me
RESEND_FROM_EMAIL=SUTH iCare <no-reply@mail.example.org>
OTP_HMAC_SECRET=replace_with_a_random_secret_at_least_32_characters_long
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Use enroll while staff email addresses are being verified; required enables OTP at staff sign-in.
STAFF_EMAIL_OTP_MODE=enroll
EMAIL_DAILY_BUDGET=100
EMAIL_MONTHLY_BUDGET=3000

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PDPA rollout: schema migration precedes enabling this release. Never rotate AES_SEARCH_KEY during backfill.
DATA_ENCRYPTION_KEYS={"legacy":"replace_with_64_hex_characters","v1":"replace_with_an_independent_64_hex_key"}
DATA_ENCRYPTION_ACTIVE_KEY=v1
SESSION_CSRF_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
DB_TLS_CA_FILE=
FORM_INVITATION_TTL_SECONDS=86400
STAFF_TRUSTED_DEVICE_ENABLED=false
# Production requires HTTPS same-origin /api, CA/host validation and Email OTP for every staff account.
# Set true only after the envelope reader and schema have passed staging checks.
PDPA_ENCRYPTED_WRITER_ENABLED=false
# Confirm the PDFs contain only approved demonstration data before release.
MANUALS_PRIVACY_REVIEWED=false
# Disable only after reconciliation and removal of legacy plaintext have passed.
PDPA_LEGACY_READ_ENABLED=true
