# Database dumps — may contain real patient data, never commit
*.sql
# Schema migrations contain no patient data and are required by
# server/scripts/migrateProductionBaseline.js on every deployment.
!server/migrations/
!server/migrations/*.sql

# Environment / secrets
.env
.env.*
!.env.example
!app/.env.production
!app/.env.production.example

# Dependencies
node_modules/
.worktrees/
backup/
**/build/
.deploy/
*.lnk

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
/.freebuff
*.yml
*.example
*.production
# Later rules win: re-include the templates and workspace files a fresh clone needs.
!.env.example
!server/.env.example
!app/.env.example
!app/.env.production.example
/app/e2e-audit
/app/e2e
DEPLOY.md
CONTEXT.md
/docs
PATIENT_ACCOUNT_IDENTITY_PLAN.md
PATIENT_HISTORY_AUTH_PLAN.md
*.yaml
!pnpm-workspace.yaml
!pnpm-lock.yaml
QUALITY_AUDIT.md
REMEDIATION_PLAN.md
/scripts
