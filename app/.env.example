# Vite uses the same-origin API path in local development and production.
VITE_API_URL=/api
VITE_DEV_PORT=3001
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Public Cloudflare Turnstile site key. Never put the secret key in VITE_*.
VITE_TURNSTILE_SITE_KEY=replace_me

# Local-only escape hatch. Production packaging always forces this to false.
VITE_DISABLE_TURNSTILE=false
